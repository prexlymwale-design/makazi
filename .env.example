# Copy to .env for local configuration. No credentials are included.
NODE_ENV=development
PORT=4173
DB_PATH=./data/makazi.sqlite
SESSION_TTL_HOURS=12
# Uncomment this to run the app against PostgreSQL after starting the Compose database.
# MAKAZI_DATABASE_URL=postgresql://makazi_app:replace_with_a_private_app_password@127.0.0.1:5432/makazi
# Production provider URLs are also accepted when MAKAZI_DATABASE_URL is unset.
# SUPABASE_DATABASE_URL=postgresql://makazi_runtime.project-ref:...@...pooler.supabase.com:6543/postgres
# NETLIFY_DB_URL=postgresql://...
# NETLIFY_DATABASE_URL=postgresql://...

# Optional PostgreSQL runtime and integration tests.
# Replace both values with private, unique passwords before running docker compose.
POSTGRES_ADMIN_PASSWORD=replace_with_a_private_admin_password
APP_DB_PASSWORD=replace_with_a_private_app_password
POSTGRES_PORT=5432
# Enable this only when running PostgreSQL checks against the disposable test database.
# MAKAZI_TEST_DATABASE_URL=postgresql://makazi_app:replace_with_a_private_app_password@127.0.0.1:5432/makazi_test

# Optional Daraja integration. Leave blank to keep real M-Pesa collection disabled.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
